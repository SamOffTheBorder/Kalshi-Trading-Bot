# =============================================================================
# kalshi-bot configuration
#
# GENERATED FILE — do not edit by hand.
# Source of truth: src/kalshi_bot/config/settings.py
# Regenerate with:  uv run python scripts/generate_env_example.py
#
# Copy to `.env` and fill in values. Secrets are left blank; all credentials
# are optional — backtesting against public data needs none of them.
# =============================================================================

# Master switch. True = simulated fills only. Flipping to False is gated behind the live-trading
# confirmation flow; never edit casually.
PAPER_TRADING=true

# Kalshi API key ID from the Kalshi dashboard. Not needed for backtesting.
KALSHI_KEY_ID=

# Path to the RSA private key PEM used for RSA-PSS request signing. Keep under secrets/
# (gitignored). Kalshi cannot recover a lost key; rotate ~90 days.
KALSHI_PRIVATE_KEY_PATH=secrets/kalshi_private_key.pem

# True = Kalshi demo environment; False = production exchange.
KALSHI_USE_DEMO_ENV=true

# Required before any Kalshi client will place/amend a real order or exit trigger against
# production with paper_trading=False. Must be set to the literal phrase 'I understand this places
# real orders' (case-sensitive) for the guard to open; anything else, including unset, keeps
# production order placement blocked. This is the live-trading confirmation flow referenced by
# paper_trading's own description above — a deliberate typing exercise, not a UI, so flipping to
# live trading can never happen by editing one boolean.
LIVE_TRADING_CONFIRMATION_PHRASE=

# Total trading capital, in USD.
BANKROLL_TOTAL_USD=200.0

# Fractional Kelly multiplier. 0.25 = quarter-Kelly (conservative default; edge estimates are
# uncertain). Documented tunable band: 0.25-0.5. Backtest comparison only (design D3) — does not
# size live orders.
KELLY_FRACTION=0.25

# Fixed-fractional risk per trade for live sizing (risk/fixed_risk.py, design D3): fraction of
# equity lost if the stop is hit. Documented tunable band: 1-2%. Replaces Kelly on the live path —
# Kelly requires a win-probability estimate Phase 1 proved untrustworthy (model said 40%, actually
# won 20%).
RISK_PCT=0.01

# Perps leverage cap (risk/leverage_governor.py, spec: perps-trading 'Leverage ceiling below
# exchange maximum'). Default 2x; hard ceiling 3x regardless of the higher maximum Kalshi itself
# permits — enforced in code (HARD_LEVERAGE_CEILING), not just by this field's bound.
MAX_LEVERAGE=2.0

# Hard cap on any single position as a fraction of that broker's bankroll, applied AFTER Kelly
# sizing as a min() clamp. Kelly output can never exceed this.
MAX_POSITION_PCT=0.05

# Minimum fee-adjusted edge (expected value per contract dollar) required to enter. Fee is
# subtracted BEFORE this gate.
MIN_EDGE=0.05

# Maximum |BS - MC| probability disagreement. Larger divergence means the pricing model is
# strained -> HOLD regardless of apparent edge.
MAX_MODEL_DIVERGENCE=0.06

# Skip contracts whose estimated win probability is below this (longshot-bias guard; v1's losses
# clustered in cheap contracts).
MIN_ENTRY_PROBABILITY=0.3

# Skip contracts whose estimated win probability is above this (overpriced-favorite guard; thin
# payoff rarely survives fees).
MAX_ENTRY_PROBABILITY=0.8

# No new entries closer to expiry than this — near-expiry gamma noise makes model estimates
# unreliable.
MIN_MINUTES_TO_EXPIRY=10.0

# Trend-regime gate: HOLD when |realized log-return over the lookback| exceeds this many model
# sigmas (vol*sqrt(t)). The zero-drift BS/MC pricer fades trends it cannot see — run #4's losses
# all came from one such episode.
MAX_TREND_ZSCORE=1.5

# Lookback window (hours) for the trend-regime z-score.
TREND_LOOKBACK_HOURS=24.0

# Episode/cluster guard: max filled entries per series within the rolling
# entry_throttle_window_hours. Backtest run #4 lost to 23 entries fading one 15-hour trend; per-
# trade caps alone don't bound an episode.
MAX_ENTRIES_PER_SERIES_WINDOW=3

# Rolling window (hours) over which max_entries_per_series_window is enforced.
ENTRY_THROTTLE_WINDOW_HOURS=24.0

# Drawdown from peak (per broker) at which NEW entries pause. Recalibrate against backtest output
# before live trading.
MAX_DRAWDOWN_PAUSE_PCT=0.25

# Drawdown from peak (per broker) triggering full halt + close-all via EmergencyControl. Must be >
# max_drawdown_pause_pct.
MAX_DRAWDOWN_HALT_PCT=0.4

# Trailing window (days) for the drawdown guard's reference peak. An all-time peak makes PAUSE
# permanently sticky in a settle-to-flat book (equity can't move while paused) — backtest runs
# #3-#5 starved every out-of-sample segment this way. HALT stays sticky regardless.
DRAWDOWN_PEAK_WINDOW_DAYS=7.0

# Halt new entries for the rest of the UTC day once realized PnL since midnight UTC falls below
# -max_daily_loss_usd (risk/daily_loss_guard.py, EmergencyControl). Independent of the broader
# equity-curve DrawdownGuard — a bad day can trip this without yet being a broader drawdown.
MAX_DAILY_LOSS_USD=20.0

# Halt new entries after this many losing trades in a row (any win resets the streak). A losing
# streak usually means the strategy's edge assumption broke for current conditions, a distinct
# failure mode from ordinary variance (risk/daily_loss_guard.py, EmergencyControl).
MAX_CONSECUTIVE_LOSSES=5

# OpenRouter API key. Used ONLY for sparse high-stakes calls (pre-trade veto, periodic strategy
# review).
OPENROUTER_API_KEY=

# Hard monthly cap on OpenRouter spend. On exhaustion the bot falls back to :free-tier models /
# local Ollama; the veto gate stays fail-closed.
OPENROUTER_MONTHLY_BUDGET_USD=15.0

# Local Ollama endpoint for routine/frequent LLM tasks (regime classification).
OLLAMA_BASE_URL=http://localhost:11434

# Telegram bot token from @BotFather. Optional; enables Telegram alerts + commands.
TELEGRAM_BOT_TOKEN=

# Telegram chat ID authorized to command the bot. Commands from other chats are ignored.
TELEGRAM_CHAT_ID=

# Discord bot token. Optional; enables Discord alerts + commands.
DISCORD_BOT_TOKEN=

# SQLite database path (single schema of record). Portable to Postgres later.
DB_PATH=data/kalshi_bot.db

# Log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Shared secret for the LAN-exposed dashboard. Required before the web UI starts.
DASHBOARD_AUTH_SECRET=

# JSON registry of crypto assets; lifecycle and venue mappings are validated before use.
CRYPTO_REGISTRY=[{"asset_id":"BTC","display_name":"BTC","correlation_group":"major-crypto","spot_symbols":["BTC-USD"],"event_instruments":{"15m":{"cadence":"15m","series_ticker":"KXBTC15M","contract_shape":"binary","lifecycle":"backtest","enabled":true,"market_ticker":null},"60m":{"cadence":"60m","series_ticker":"KXBTC","contract_shape":"strike_ladder","lifecycle":"backtest","enabled":true,"market_ticker":null}},"perp":{"market_ticker":"KXBTCPERP","reference_index":"BTCUSD_RTI","multiplier":null,"minimum_order_size":null,"max_leverage":null}},{"asset_id":"ETH","display_name":"ETH","correlation_group":"major-crypto","spot_symbols":["ETH-USD"],"event_instruments":{"15m":{"cadence":"15m","series_ticker":"KXETH15M","contract_shape":"binary","lifecycle":"backtest","enabled":true,"market_ticker":null},"60m":{"cadence":"60m","series_ticker":"KXETHD","contract_shape":"strike_ladder","lifecycle":"backtest","enabled":true,"market_ticker":null}},"perp":{"market_ticker":"KXETHPERP","reference_index":"ETHUSD_RTI","multiplier":null,"minimum_order_size":null,"max_leverage":null}},{"asset_id":"SOL","display_name":"SOL","correlation_group":"major-crypto","spot_symbols":["SOL-USD"],"event_instruments":{"15m":{"cadence":"15m","series_ticker":"KXSOL15M","contract_shape":"binary","lifecycle":"observe","enabled":true,"market_ticker":null},"60m":{"cadence":"60m","series_ticker":"KXSOLD","contract_shape":"strike_ladder","lifecycle":"observe","enabled":true,"market_ticker":null}},"perp":{"market_ticker":"KXSOLPERP","reference_index":"SOLUSD_RTI","multiplier":null,"minimum_order_size":null,"max_leverage":null}},{"asset_id":"XRP","display_name":"XRP","correlation_group":"major-crypto","spot_symbols":["XRP-USD"],"event_instruments":{"15m":{"cadence":"15m","series_ticker":"KXXRP15M","contract_shape":"binary","lifecycle":"observe","enabled":true,"market_ticker":null},"60m":{"cadence":"60m","series_ticker":"KXXRPD","contract_shape":"strike_ladder","lifecycle":"observe","enabled":true,"market_ticker":null}},"perp":{"market_ticker":"KXXRPPERP","reference_index":"XRPUSD_RTI","multiplier":null,"minimum_order_size":null,"max_leverage":null}}]
